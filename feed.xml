---
# Flux Atom généré par Jekyll (front matter vide : nécessaire pour
# que Liquid soit traité, y compris hors GitHub Pages).
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     Vesper Atelier — flux Atom
     Les brouillons (_drafts/) en sont exclus automatiquement.
     ============================================================ -->
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}"/>
  <updated>{{ site.posts.first.date | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>

  <author>
    <name>{{ site.author.name }}</name>
    <email>{{ site.author.email }}</email>
  </author>

  {% for post in site.posts limit: 10 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    {% for categorie in post.categories %}<category term="{{ categorie }}"/>{% endfor %}
    <summary type="html">{{ post.excerpt | strip_html | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
